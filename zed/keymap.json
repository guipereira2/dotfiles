// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-b": "workspace::ToggleRightDock",
            "ctrl-a b": "project_panel::ToggleFocus",
            "ctrl-a a": "agent::Toggle",
            "ctrl-a o": "outline_panel::ToggleFocus",
            "ctrl-a j": "multi_workspace::ToggleWorkspaceSidebar",
            "ctrl-a g": "git_panel::Toggle",
            "ctrl-a p": "diagnostics::Deploy",
            "ctrl-a [": "workspace::ActivatePaneLeft",
            "ctrl-a ]": "workspace::ActivatePaneRight",
            "ctrl-a t": "terminal_panel::ToggleFocus",
            "ctrl-a n": "file_finder::Toggle",
            "ctrl-a d": "pane::DeploySearch",
            "ctrl-a i": "workspace::ToggleZoom",
            "ctrl-a l": "go_to_line::Toggle",
            "ctrl-a k": "command_palette::Toggle",
        },
    },
    {
        "context": "Editor && !menu",
        "bindings": {
            "ctrl-b": "workspace::ToggleRightDock",
            "ctrl-shift-c": "editor::Copy",
            "ctrl-v": "editor::Paste",
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "ctrl-a d": "project_panel::NewDirectory",
            "ctrl-a f": "project_panel::NewFile",
        },
    },
    {
        "context": "BufferSearchBar",
        "bindings": {
            "ctrl-n": "search::SelectNextMatch",
            "ctrl-p": "search::SelectPreviousMatch",
        },
    },
    {
        "context": "ProjectSearchBar",
        "bindings": {
            "ctrl-a r": "search::ToggleReplace",
        },
    },
    {
        "context": "ProjectSearchView",
        "bindings": {
            "ctrl-a r": "search::ToggleReplace",
        },
    },
    {
        "context": "ProjectSearchView > Editor && VimControl",
        "bindings": {
            "enter": "editor::OpenExcerpts",
        },
    },
    {
        "context": "ProjectSearchBar && in_replace > Editor",
        "bindings": {
            "ctrl-enter": "search::ReplaceAll",
        },
    },
    {
        "context": "Pane",
        "bindings": {
            "ctrl-w": [
                "pane::CloseActiveItem",
                {
                    "close_pinned": false,
                },
            ],
        },
    },
    {
        "context": "Editor",
        "bindings": {
            "ctrl-a w": "outline::Toggle",
            "ctrl-a h": "editor::ToggleInlayHints",
            "ctrl-a f": "buffer_search::Deploy",
            "ctrl-a r": "buffer_search::DeployReplace",
            "ctrl-a m": "editor::AddSelectionBelow",
            "ctrl-a s": "pane::SplitRight",
            "ctrl-a c": ["editor::ToggleComments", { "advance_downwards": false }],
            "ctrl-a z": "editor::ReloadFile",
            "ctrl-s": "workspace::Save",
            "ctrl-d": "editor::ShowCompletions",
            "ctrl-;": null,
            "ctrl-\\": null,
        },
    },
    {
        "context": "Editor && extension == md",
        "bindings": {
            "ctrl-a v": "markdown::OpenPreview",
        },
    },
    {
        "context": "Editor && (extension == csv || extension == tsv || extension == ssv || extension == psv)",
        "bindings": {
            "ctrl-a v": "tabular_data::OpenPreview",
        },
    },
    {
        "context": "FileFinder || (FileFinder > Picker > Editor)",
        "bindings": {
            "ctrl-a p": "picker::TogglePreview",
            "ctrl-a a": "picker::ToggleActionsMenu",
        },
    },
    {
        "context": "(Picker && with_preview) > Editor",
        "bindings": {
            "ctrl-a p": "picker::TogglePreview",
        },
    },
    {
        "context": "NotebookEditor",
        "bindings": {
            "ctrl-a n c": "notebook::AddCodeBlock",
            "ctrl-a n m": "notebook::AddMarkdownBlock",
            "ctrl-a c o": "notebook::ClearOutputs",
            "ctrl-a r k": "notebook::RestartKernel",
            "ctrl-enter": "notebook::Run",
        },
    },
    {
        "context": "NotebookEditor > Editor",
        "bindings": {
            "ctrl-a n c": "notebook::AddCodeBlock",
            "ctrl-a n m": "notebook::AddMarkdownBlock",
            "ctrl-a c o": "notebook::ClearOutputs",
            "ctrl-a r k": "notebook::RestartKernel",
            "ctrl-enter": "notebook::Run",
        },
    },
    {
        "context": "NotebookEditor && notebook_mode == command",
        "bindings": {
            "d d": "notebook::DeleteCell",
        },
    },
]
